# Copy to .env for local overrides. .env is gitignored; never commit real values.
# Every setting is listed in src/rusnipez/settings.py.

# Terms to poll, most important first; the first is the website's default.
RUSNIPEZ_ACTIVE_TERMS=12027,02027

# Defaults to the compose database on 127.0.0.1:5432.
# RUSNIPEZ_DATABASE_URL=postgresql+asyncpg://rusnipez:rusnipez@127.0.0.1:5432/rusnipez

# Discord bot. Leave the token unset to run without it. The bot works in the one
# server below and leaves any other. `rusnipez discord-invite` prints its invite
# link and `rusnipez discord-setup` creates the server's channels.
# RUSNIPEZ_DISCORD_TOKEN=
# RUSNIPEZ_DISCORD_GUILD_ID=
# RUSNIPEZ_DISCORD_APPLICATION_ID=
# RUSNIPEZ_DISCORD_OWNER_IDS=

# Website build (set in web/.env.local or the host's environment): Discord invite link.
# VITE_DISCORD_INVITE=https://discord.gg/...
